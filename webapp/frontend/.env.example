# Copy this file to .env and fill in your values.
# For local dev, VITE_API_URL points to the old server.js backend.
# For production (Amplify), set these in Amplify > App Settings > Environment variables.

# API Gateway HTTP API URL (from AWS Console after deploying api-handler Lambda)
# Example: https://xxxxxxxxxx.execute-api.us-east-1.amazonaws.com
VITE_API_URL=https://YOUR_API_GATEWAY_ID.execute-api.YOUR_REGION.amazonaws.com

# Cognito User Pool (from AWS Cognito Console)
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com

# Pusher Channels (from https://pusher.com — free, no card required)
# Create a Channels app, then copy Key and Cluster from the app dashboard.
VITE_PUSHER_KEY=YOUR_PUSHER_APP_KEY
VITE_PUSHER_CLUSTER=ap1
